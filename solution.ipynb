#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Traffic Demand Forecasting v2 — CatBoost champion, no target encoding.
Metric: R² | Stratified 5-Fold CV
"""
import os, sys, warnings, gc, pickle, math, random
import numpy as np
import pandas as pd
from pathlib import Path
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import r2_score
from sklearn.preprocessing import LabelEncoder
import xgboost as xgb
import lightgbm as lgb
from catboost import CatBoostRegressor

warnings.filterwarnings('ignore')
np.random.seed(42); random.seed(42)
BASE = Path(os.path.abspath('')).resolve()
N_FOLDS = 5

train = pd.read_csv(BASE/'train.csv')
test  = pd.read_csv(BASE/'test.csv')
print(f"Train: {train.shape}  Test: {test.shape}")

def engineer(df):
    df = df.copy()
    parts = df['timestamp'].str.split(':', expand=True)
    df['hour'] = parts[0].astype(int); df['minute'] = parts[1].astype(int)
    df['hour_sin'] = np.sin(2*math.pi*df['hour']/24)
    df['hour_cos'] = np.cos(2*math.pi*df['hour']/24)
    df['time_of_day'] = df['hour']+df['minute']/60
    df['day_mod7'] = df['day']%7; df['is_weekend']=(df['day_mod7']>=5).astype(int)
    df['is_day49']=(df['day']==49).astype(int)
    import geohash2
    df['lat'],df['lng']=zip(*df['geohash'].apply(lambda g: geohash2.decode(g) if pd.notna(g) else (np.nan,np.nan)))
    for p in [4,5,6]: df[f'geo_p{p}']=df['geohash'].str[:p]
    for c in ['RoadType','Temperature','Weather']: df[f'{c}_missing']=df[c].isna().astype(int)
    df['RoadType']=df['RoadType'].fillna('Unknown')
    df['road_tier']=df['RoadType'].map({'Residential':0,'Street':1,'Highway':2,'Unknown':-1})
    for t in ['highway','street','residential']: df[f'is_{t}']=(df['RoadType']==t.capitalize()).astype(int)
    df['NumberofLanes']=df['NumberofLanes'].fillna(-1).astype(int)
    df['has_many_lanes']=(df['NumberofLanes']>=4).astype(int)
    df['LargeVehicles_num']=df['LargeVehicles'].map({'Not Allowed':0,'Allowed':1}).fillna(-1)
    df['Landmarks_num']=df['Landmarks'].map({'No':0,'Yes':1}).fillna(-1)
    df['Weather']=df['Weather'].fillna('Unknown')
    df['weather_code']=df['Weather'].map({'Sunny':0,'Rainy':1,'Foggy':2,'Snowy':3,'Unknown':-1})
    df['Temperature']=df.groupby(['hour','geo_p5'])['Temperature'].transform(lambda s:s.fillna(s.median())).fillna(df['Temperature'].median())
    df['rt_lanes_lv']=df['RoadType'].astype(str)+'_'+df['NumberofLanes'].astype(str)+'_'+df['LargeVehicles'].astype(str)
    for x in ['tier_x_hour','tier_x_landmarks','tier_x_lv','hour_x_temp','hour_x_lanes']:
        df[x]=0
    df['tier_x_hour']=df['road_tier']*df['hour']
    df['tier_x_landmarks']=df['road_tier']*df['Landmarks_num']
    df['tier_x_lv']=df['road_tier']*df['LargeVehicles_num']
    df['hour_x_temp']=df['hour']*df['Temperature']
    df['hour_x_lanes']=df['hour']*df['NumberofLanes']
    gc=df['geo_p5'].value_counts().to_dict()
    df['geo_p5_freq']=df['geo_p5'].map(gc)/len(df)
    grc=df.groupby(['geo_p5','RoadType']).size().groupby(level=0).transform(lambda s:s/s.sum()).to_dict()
    df['geo_p5_highway_ratio']=df.set_index(['geo_p5','RoadType']).index.map(grc).fillna(0)
    return df

train_fe=engineer(train); test_fe=engineer(test)
CAT=['RoadType','Weather','geo_p4','geo_p5','rt_lanes_lv','LargeVehicles','Landmarks']
NUM=[c for c in ['day','hour','minute','hour_sin','hour_cos','time_of_day','day_mod7','is_weekend','is_day49','NumberofLanes','road_tier','is_highway','is_street','is_residential','has_many_lanes','LargeVehicles_num','Landmarks_num','weather_code','Temperature','RoadType_missing','Temperature_missing','Weather_missing','tier_x_hour','tier_x_landmarks','tier_x_lv','hour_x_temp','hour_x_lanes','lat','lng','geo_p5_freq','geo_p5_highway_ratio'] if c in train_fe.columns]
CAT=[c for c in CAT if c in train_fe.columns]
ALLF=NUM+CAT
print(f"Features: {len(ALLF)} ({len(NUM)} num + {len(CAT)} cat)")
for col in CAT:
    le=LabelEncoder(); le.fit(pd.concat([train_fe[col],test_fe[col]]).astype(str))
    train_fe[col]=le.transform(train_fe[col].astype(str)); test_fe[col]=le.transform(test_fe[col].astype(str))
X_train=train_fe[ALLF].values.astype(np.float32); y_train=train_fe['demand'].values.astype(np.float32)
X_test=test_fe[ALLF].values.astype(np.float32)
X_train_cb=pd.DataFrame(X_train,columns=ALLF); X_test_cb=pd.DataFrame(X_test,columns=ALLF)
for col in CAT: X_train_cb[col]=X_train_cb[col].astype(int).astype(str); X_test_cb[col]=X_test_cb[col].astype(int).astype(str)
strata=pd.qcut(train_fe['road_tier'].values+np.random.randn(len(train_fe))*0.01,q=N_FOLDS,labels=False,duplicates='drop')
if len(set(strata))<N_FOLDS: strata=(train_fe['road_tier'].values+1).astype(int)%N_FOLDS
skf=StratifiedKFold(n_splits=N_FOLDS,shuffle=True,random_state=42)

def cv_score(mfn,params,mtype='sklearn',es=80):
    sc,ms,fs=[],[],[]
    for ti,vi in skf.split(X_train,strata):
        yt,yv=y_train[ti],y_train[vi]
        if mtype=='catboost':
            Xt,Xv=X_train_cb.iloc[ti],X_train_cb.iloc[vi]
            m=mfn(**params).fit(Xt,yt,eval_set=(Xv,yv),cat_features=CAT,verbose=False,early_stopping_rounds=es)
        elif mtype=='lgb':
            Xt,Xv=X_train[ti],X_train[vi]; p=params.copy(); p['n_estimators']=10000
            m=mfn(**p).fit(Xt,yt,eval_set=[(Xv,yv)],callbacks=[lgb.early_stopping(es),lgb.log_evaluation(0)])
        else:
            Xt,Xv=X_train[ti],X_train[vi]; p=params.copy(); p['n_estimators']=10000; p['early_stopping_rounds']=es
            m=mfn(**p).fit(Xt,yt,eval_set=[(Xv,yv)],verbose=False)
        pr=m.predict(Xv); sc.append(r2_score(yv,pr)); ms.append(m)
        if hasattr(m,'feature_importances_'): fs.append(m.feature_importances_)
    print(f"  CV R² = {np.mean(sc):.6f} ± {np.std(sc):.6f}")
    return sc,ms,np.mean(fs,axis=0) if fs else None

# Round 1
print("\n=== R1: BASELINES ===")
R={}
R['CatBoost']=cv_score(CatBoostRegressor,{'iterations':1500,'learning_rate':0.05,'depth':6,'l2_leaf_reg':5,'random_seed':42,'verbose':0,'loss_function':'RMSE','eval_metric':'R2'},'catboost',80)
R['LightGBM']=cv_score(lgb.LGBMRegressor,{'learning_rate':0.05,'max_depth':6,'num_leaves':31,'subsample':0.8,'colsample_bytree':0.8,'reg_alpha':0.5,'reg_lambda':0.5,'random_state':42,'verbose':-1,'metric':'rmse'},'lgb',80)
R['XGBoost']=cv_score(xgb.XGBRegressor,{'learning_rate':0.05,'max_depth':6,'subsample':0.8,'colsample_bytree':0.8,'reg_alpha':0.5,'reg_lambda':0.5,'random_state':42,'verbosity':0,'objective':'reg:squarederror','eval_metric':'rmse'},'xgb',80)
for n,(s,_,_) in R.items(): print(f"  {n:12s}: {np.mean(s):.6f}")

# Round 2
print("\n=== R2: TUNED ===")
R['CatBoost_Tuned']=cv_score(CatBoostRegressor,{'iterations':3000,'learning_rate':0.025,'depth':8,'l2_leaf_reg':8,'random_strength':0.5,'od_type':'Iter','od_wait':100,'random_seed':42,'verbose':0,'loss_function':'RMSE','eval_metric':'R2','bootstrap_type':'Bernoulli','subsample':0.8,'max_ctr_complexity':4},'catboost',100)
R['LightGBM_Tuned']=cv_score(lgb.LGBMRegressor,{'learning_rate':0.025,'max_depth':8,'num_leaves':63,'subsample':0.8,'colsample_bytree':0.7,'reg_alpha':1.0,'reg_lambda':1.0,'min_child_samples':30,'min_child_weight':10,'random_state':42,'verbose':-1,'metric':'rmse','boosting_type':'gbdt'},'lgb',100)
R['XGBoost_Tuned']=cv_score(xgb.XGBRegressor,{'learning_rate':0.025,'max_depth':7,'subsample':0.8,'colsample_bytree':0.7,'reg_alpha':1.0,'reg_lambda':1.0,'min_child_weight':10,'gamma':0.2,'random_state':42,'verbosity':0,'objective':'reg:squarederror','eval_metric':'rmse','tree_method':'hist'},'xgb',100)
for n,(s,_,_) in R.items(): print(f"  {n:20s}: {np.mean(s):.6f}")

# Round 3
print("\n=== R3: REFINE ===")
R['CatBoost_R3']=cv_score(CatBoostRegressor,{'iterations':5000,'learning_rate':0.015,'depth':8,'l2_leaf_reg':10,'random_strength':1.0,'od_type':'Iter','od_wait':150,'random_seed':42,'verbose':0,'loss_function':'RMSE','eval_metric':'R2','bootstrap_type':'Bernoulli','subsample':0.75,'max_ctr_complexity':4,'min_data_in_leaf':10},'catboost',150)
bn,bs=None,-1e9
for n,(s,_,_) in R.items():
    m=np.mean(s)
    if 'Tuned' in n or 'R3' in n:
        if m>bs: bs, bn=m, n
if bn is None: bn,bs='CatBoost_Tuned',np.mean(R['CatBoost_Tuned'][0])
print(f"\n★ Champion: {bn} (CV R² = {bs:.6f})")

# Retrain & predict
_,cms,_=R[bn]
if 'CatBoost' in bn:
    p={'iterations':5000,'learning_rate':0.015,'depth':8,'l2_leaf_reg':10,'random_strength':1.0,'od_type':'Iter','od_wait':150,'random_seed':42,'verbose':0,'loss_function':'RMSE','eval_metric':'R2','bootstrap_type':'Bernoulli','subsample':0.75,'max_ctr_complexity':4}
    m=CatBoostRegressor(**p).fit(X_train_cb,y_train,cat_features=CAT,verbose=0)
    ens=np.clip(np.mean([fm.predict(X_test_cb) for fm in cms],axis=0),0,1)
else:
    p={'learning_rate':0.025,'max_depth':8,'num_leaves':63,'subsample':0.8,'colsample_bytree':0.7,'reg_alpha':1.0,'reg_lambda':1.0,'min_child_samples':30,'min_child_weight':10,'random_state':42,'verbose':-1,'metric':'rmse','boosting_type':'gbdt'}
    m=lgb.LGBMRegressor(**p).fit(X_train,y_train)
    ens=np.clip(np.mean([fm.predict(X_test) for fm in cms],axis=0),0,1)

pd.DataFrame({'Index':test['Index'].values,'demand':ens}).to_csv(BASE/'submission.csv',index=False)
print(f"Saved submission.csv ({len(ens)} rows) [{ens.min():.6f}, {ens.max():.6f}]")
